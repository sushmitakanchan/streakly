{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/prisma/**",
          "backend/src/generated/prisma/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "backend/src/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
